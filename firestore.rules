rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 帖のIDは合言葉から作った40文字。IDを知らない人は一覧も中身も見られない
    match /households/{hid} {
      allow get, create, update: if request.auth != null && hid.size() == 40;

      match /cards/{cardId} {
        allow read, write: if request.auth != null && hid.size() == 40;
      }
      match /records/{recordId} {
        allow read, write: if request.auth != null && hid.size() == 40;
      }
    }
  }
}
